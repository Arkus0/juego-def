# Unity writes LF; keep it LF in the working copy too so Editor saves do not churn line endings on Windows.
Unity/JuegoDef/**/*.unity         text eol=lf
Unity/JuegoDef/**/*.prefab        text eol=lf
Unity/JuegoDef/**/*.asset         text eol=lf
Unity/JuegoDef/**/*.mat           text eol=lf
Unity/JuegoDef/**/*.meta          text eol=lf
Unity/JuegoDef/**/*.controller    text eol=lf
Unity/JuegoDef/**/*.anim          text eol=lf
Unity/JuegoDef/**/*.json          text eol=lf
Unity/JuegoDef/**/*.txt           text eol=lf
Unity/JuegoDef/**/*.cs            text eol=lf
Unity/JuegoDef/**/*.asmdef        text eol=lf
*.py                              text eol=lf
*.md                              text eol=lf
.gitignore                        text eol=lf
.gitattributes                    text eol=lf

# ANIM evidence hashes must survive Windows checkout without newline conversion.
Docs/asset_catalog/anim*.json      text eol=lf
Docs/evidence/WP-PROD-ANIM-01/*.json text eol=lf
Docs/evidence/WP-PROD-ANIM-01/captures/*.txt text eol=lf

*.png   binary
*.jpg   binary
*.fbx   binary
*.wav   binary
*.ogg   binary
Unity/JuegoDef/Assets/JuegoDef/Scenes/ENV/ENV01_AUTHORED.unity filter=lfs diff=lfs merge=lfs -text
Unity/JuegoDef/Assets/JuegoDef/Scenes/ENV/ENV01_REFERENCE.unity filter=lfs diff=lfs merge=lfs -text
Unity/JuegoDef/Assets/JuegoDef/Scenes/CITY_IVX/*.unity filter=lfs diff=lfs merge=lfs -text
Unity/JuegoDef/Assets/JuegoDef/Scenes/CITY_IVX/CITY_IVX_NavMesh.asset filter=lfs diff=lfs merge=lfs -text
