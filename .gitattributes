# Unity writes LF; keep it LF in the working copy too so Editor saves do not churn line endings on Windows.
Unity/JuegoDef/**/*.unity         text eol=lf
Unity/JuegoDef/**/*.prefab        text eol=lf
Unity/JuegoDef/**/*.asset         text eol=lf
Unity/JuegoDef/**/*.mat           text eol=lf
Unity/JuegoDef/**/*.meta          text eol=lf
Unity/JuegoDef/**/*.controller    text eol=lf
Unity/JuegoDef/**/*.overrideController text eol=lf
Unity/JuegoDef/**/*.anim          text eol=lf
Unity/JuegoDef/**/*.json          text eol=lf
Unity/JuegoDef/**/*.txt           text eol=lf
Unity/JuegoDef/**/*.cs            text eol=lf
Unity/JuegoDef/**/*.asmdef        text eol=lf
*.py                              text eol=lf
*.md                              text eol=lf
.gitignore                        text eol=lf
.gitattributes                    text eol=lf

# ANIM evidence hashes must survive Windows checkout without newline conversion.
Docs/asset_catalog/anim*.json      text eol=lf
Docs/evidence/WP-PROD-ANIM-01/*.json text eol=lf
Docs/evidence/WP-PROD-ANIM-01/captures/*.txt text eol=lf
Docs/asset_catalog/char*.json      text eol=lf
Docs/evidence/WP-PROD-CHAR-01/*.json text eol=lf
# Byte-bound evidence metadata must survive a Windows checkout unchanged.
Docs/evidence/WP-PROD-ASSET-00/catalog.json -text
Docs/evidence/WP-PROD-CHAR-01/*.json -text
Docs/evidence/WP-PROD-CHAR-01/**/*.json -text
Docs/evidence/WP-PROD-CHAR-01/**/*.txt -text
Tools/Char*.cs                   text eol=lf
Unity/JuegoDef/**/*.shader       text eol=lf
Unity/JuegoDef/**/*.hlsl          text eol=lf
# Preserve the audited unmodified vendor snapshot byte-for-byte.
Tools/vendor/chilyer/body_topo.py -text
Tools/vendor/chilyer/LICENSE -text
Art/Characters/HumanSources/** -text
Art/Characters/HumanHeads/*.json -text

*.png   binary
*.jpg   binary
*.gif   binary
*.gz    binary
*.fbx   binary
*.blend binary
*.wav   binary
*.ogg   binary
